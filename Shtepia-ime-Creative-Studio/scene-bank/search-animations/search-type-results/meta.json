{
  "id": "search-type-results",
  "name": "Type a search, see results",
  "mode": "ui-motion",
  "technique": "The camera flies into the real search field, a query is typed into it at reading pace (with caret), then pulls back to the real results grid, which is spotlit with a callout taken from the screen's own count line.",
  "duration": 4.0,
  "in": "none",
  "out": "blur",
  "vars": {
    "title": {
      "type": "string",
      "label": "Headline (*accent*)",
      "default": {
        "sq": "Kërko *qytetin tënd.*",
        "en": "Search *your city.*",
        "it": "Cerca *la tua città.*"
      }
    },
    "query": {
      "type": "string",
      "label": "Typed query",
      "default": {
        "sq": "Tiranë",
        "en": "Tirana",
        "it": "Tirana"
      },
      "maxLength": 28
    },
    "screen": {
      "type": "enum",
      "label": "Screen",
      "default": "explore",
      "options": [
        "explore",
        "home"
      ]
    },
    "callout": {
      "type": "string",
      "label": "Callout",
      "default": {
        "sq": "6 prona në shikim",
        "en": "6 homes in view",
        "it": "6 immobili in vista"
      }
    },
    "zoom": {
      "type": "number",
      "label": "Zoom on field",
      "default": 1.9,
      "min": 1.2,
      "max": 3,
      "step": 0.1
    },
    "theme": {
      "type": "enum",
      "label": "App theme",
      "default": "light",
      "options": [
        "light",
        "dark"
      ]
    }
  },
  "screens": true,
  "features": [
    "search",
    "grid-view"
  ],
  "notes": "The callout must match the screen ('6 prona në shikim' is what the explore screenshot shows).",
  "sfx": [
    {
      "id": "type-tick",
      "at": 0.9,
      "volume": 0.35
    },
    {
      "id": "type-tick",
      "at": 1.1,
      "volume": 0.35
    },
    {
      "id": "type-tick",
      "at": 1.3,
      "volume": 0.35
    },
    {
      "id": "pop",
      "at": 2.6,
      "volume": 0.4
    }
  ],
  "tags": [
    "search",
    "ui",
    "typing"
  ]
}