{
  "id": "map-app-clusters",
  "name": "App map: zoom to clusters",
  "mode": "ui-motion",
  "technique": "Real UI only: on the explore screen the map toggle is pressed (the real pixels depress), the view switches to the real map screen, the camera flies to the Tirana cluster, everything else dims under a spotlight and a callout names the feature.",
  "duration": 3.6,
  "in": "none",
  "out": "zoom-in",
  "vars": {
    "title": { "type": "string", "label": "Headline (*accent*)", "default": "Eksploro *në hartë.*" },
    "from": { "type": "enum", "label": "Start screen", "default": "explore", "options": ["explore", "map"] },
    "region": { "type": "enum", "label": "Region to focus", "default": "clusterTirana", "options": ["clusterTirana", "clusterSouthA", "clusterSouthB", "count"] },
    "callout": { "type": "string", "label": "Callout", "default": "3 prona në Tiranë" },
    "zoom": { "type": "number", "label": "Zoom", "default": 2.2, "min": 1.2, "max": 4, "step": 0.1 },
    "theme": { "type": "enum", "label": "App theme", "default": "light", "options": ["light", "dark"] }
  },
  "screens": true,
  "features": ["map-view"],
  "notes": "The callout must match what the screen shows (the Tirana cluster reads 3 on the demo data).",
  "sfx": [{ "id": "ui-tap", "at": 0.9, "volume": 0.6 }, { "id": "ui-swipe", "at": 1.15, "volume": 0.4 }, { "id": "pop", "at": 2.55, "volume": 0.4 }],
  "tags": ["map", "ui", "spotlight"]
}
