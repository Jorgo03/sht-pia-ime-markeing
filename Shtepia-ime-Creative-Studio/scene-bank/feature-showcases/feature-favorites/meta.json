    "region": { "type": "string", "label": "Heart region", "default": "featuredHeart" },
    "zoom": { "type": "number", "label": "Zoom", "default": 2.4, "min": 1.2, "max": 4, "step": 0.1 },
    "theme": { "type": "enum", "label": "App theme", "default": "light", "options": ["light", "dark"] }
