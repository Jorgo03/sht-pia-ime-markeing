    "place": { "type": "string", "label": "Override name", "default": "" },
    "region": { "type": "string", "label": "Region line", "default": "Shqipëri" },
    "photo": { "type": "string", "label": "Plate photo", "default": "assets/property-images/living-tirana.jpg" }
  },
  "sfx": [{ "id": "ambient-city", "at": 0.0, "volume": 0.3 }, { "id": "type-tick", "at": 0.5, "volume": 0.3 }],
