    "after": { "type": "string", "label": "Line after the press (*accent* = dark)", "default": "Shtëpia.ime. *Link në bio.*" }
  },
  "sfx": [{ "id": "pop", "at": 0.38, "volume": 0.45 }, { "id": "ui-tap", "at": 1.85, "volume": 0.7 }, { "id": "whoosh-air", "at": 2.0, "volume": 0.45 }],
  "tags": ["cta", "button", "flood"]
